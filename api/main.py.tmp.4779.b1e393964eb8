"""FastAPI 엔트리포인트 — 프론트엔드가 호출하는 백엔드.

  · /api/students            로그인용 학생 목록 (인강사이트 제공 가정 데이터)
  · /api/student/{id}        개인 프로필 + 성적분석 + 위험확률 + 보험료 (엔진 산출)
  · /api/student/{id}/scores 과목별 모의고사 백분위 종단데이터
  · /api/enroll              임베디드 가입 설문/약관 저장 (table01)
  · /api/chat                약관 RAG 챗봇 (student_id 있으면 개인화 설명)
  · /api/cost-forms          돈워리 계산기 정의 + 거주지 선택지
  · /api/cost-estimate       재수 비용 → 우리 집·우리 지역 기준 환산
  · /api/region-coefficients 지역계수 표 + 출처·갱신시점 (각주용)
  · /api/dontworry/explain   "왜 이 금액인가요?" — 표시 금액의 산출 근거 설명
"""
from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel
from receipt_verification import create_receipt_router

try:
    from dotenv import load_dotenv

    load_dotenv(override=True)
except Exception:  # noqa: BLE001
    pass

app = FastAPI(title="재수없수 API")
app.add_middleware(CORSMiddleware, allow_origins=["*"], allow_methods=["*"], allow_headers=["*"])
app.include_router(create_receipt_router())
application = app
handler = app


# ── 모델 ────────────────────────────────────────────────────────────────────
class ChatRequest(BaseModel):
    message: str
    history: list[dict] | None = None
    student_id: str | None = None


class EnrollRequest(BaseModel):
    name: str
    school: str | None = None
    grade_year: str | None = "고3"
    track: str | None = None
    target_univ: str | None = None
    source_site: str | None = "메가스터디"
    tier: str = "스탠다드"

    # ── 요율 반영 3문항 (약관 별표4 · '청약서 문항의 근거') ──
    # 지역규모: 특별시 / 대도시 / 중소도시 / 읍면지역  → 학원밀집도지수 4/3/2/1
    region: str = "대도시"
    household_income_manwon: int | None = None   # 월평균 가구소득
    monthly_edu_cost_manwon: int | None = None   # 피보험자 1인 월교육비

    # ── 계약 조건 ──
    enrolled_at_remaining_months: int = 33       # 잔여 납입개월 (별표2, late 산출)
    declared_subjects: list[str] | None = None   # 응시과목 선언 (별표6)
    surrender_type: str = "표준형"                # 표준형 / 무해약환급금형 (별표5)

    # ── 돈워리 계산기 전용 (요율 무관) ──
    monthly_saving: int | None = 100
    retire_goal: int | None = 20000

    terms_agreed: bool = True
    gender: str | None = None
    # 자기신고 지표(재수 의향·목표 격차 등)는 요율에서 배제하고 설문으로만 보관한다.
    survey: dict | None = None


@app.get("/")
def root():
    return {"service": "재수없수 API", "status": "ok"}


@app.get("/api/health")
def health():
    import db_supabase as db
    from rag_light import available_providers, pick_provider, selected_model_type

    provider = pick_provider()
    return {
        "status": "ok",
        "llm": provider is not None,
        "provider": provider or "fallback",
        "model": selected_model_type(provider),
        "available": available_providers(),  # 키가 채워진 프로바이더 전체
        "db": db.enabled(),
    }


# ── 학생/개인화 ──────────────────────────────────────────────────────────────
@app.get("/api/students")
def students():
    import db_supabase as db

    try:
        return {"students": db.list_students()}
    except Exception as e:  # noqa: BLE001
        return {"students": [], "error": str(e)}


@app.get("/api/tiers")
def tiers(remaining_months: int = 33):
    """티어 선택 화면용 보험료·보장 표 (포트폴리오 기준선).

    remaining_months = 잔여 납입개월. 고1 3월 최초 가입 33 ~ 고3 6월 모평 직전 6 (별표2).
    """
    import engine

    months = max(engine.MONTHS_DEADLINE, min(int(remaining_months), engine.MONTHS_FIRST))
    return {
        "tiers": engine.tier_table(months),
        "remaining_months": months,
        "late": round(engine.late_index(months), 4),
        "theta": round(engine.theta_for(months), 4),
        "cover_rate": engine.COVER_RATE,
    }


@app.get("/api/quote")
def quote():
    """가입 시점별 월납 조견표 (별표2) — "지금 들면 얼마, 미루면 얼마"."""
    import engine

    return {
        "windows": engine.quote_table(),
        "deadline": "고3 6월 모의평가 직전 (그 이후 신규 가입 불가)",
        "theta_base": engine.THETA_BASE,
        "delta_theta": engine.DELTA_THETA,
    }


@app.get("/api/regions")
def regions():
    """청약서 거주지 선택지 → 학원밀집도지수 (별표4 요율 3문항)."""
    import engine

    return {"regions": engine.REGION_CHOICES, "default": engine.DEFAULT_REGION}


@app.get("/api/cost-forms")
def cost_forms():
    """돈워리 계산기 정의 (재수 형태·지역 시세·환산 기준값)."""
    import costs

    return costs.catalog()


@app.get("/api/cost-estimate")
def cost_estimate(form: str | None = None, region: str | None = None,
                  adjust_pct: int | None = None,
                  monthly_saving: int | None = None,
                  monthly_income: int | None = None,
                  sibling_count: int | None = None,
                  retire_goal: int | None = None,
                  sido: str | None = None,
                  gu: str | None = None):
    """재수 비용 → 우리 집 기준 환산 (돈워리 결과 화면).

    sido(+서울이면 gu)를 주면 데이터 기반 지역계수를 쓴다. 안 주면 레거시 region 배율.
    """
    import costs

    return costs.estimate(form=form, region=region, adjust_pct=adjust_pct,
                          monthly_saving=monthly_saving, monthly_income=monthly_income,
                          sibling_count=sibling_count, retire_goal=retire_goal,
                          sido=sido, gu=gu)


class ExplainRequest(BaseModel):
    """돈워리 "왜 이 금액인가요?" 요청."""

    user_id: str
    재수유형: str
    # 지금 화면에서 고른 지역. 비우면 가입 시 저장한 거주지 → 없으면 전국 평균.
    sido: str | None = None
    gu: str | None = None


@app.post("/api/dontworry/explain")
def dontworry_explain(req: ExplainRequest):
    """표시된 예상 재수비용의 산출 근거를 자연어 2~3문장으로 설명한다.

    LLM 은 계산하지 않는다 — 배치가 만든 계수를 조회한 뒤 문장으로만 옮긴다.
    같은 (사용자 · 재수유형 · 지역 · 계수 기준시점) 조합은 캐시에서 즉시 돌려준다.
    """
    import dontworry_explain as dx

    try:
        return dx.explain_dontworry(req.user_id, req.재수유형,
                                    sido=req.sido, gu=req.gu)
    except dx.ExplainError as e:
        return {"error": str(e), "answer": None, "source": "error"}


@app.get("/api/region-coefficients")
def region_coefficients(sido: str | None = None, gu: str | None = None):
    """지역계수 표 + 출처·갱신시점 (돈워리 각주용).

    sido 를 주면 그 지역의 계수 분해도 함께 돌려준다. 이 엔드포인트는 공개데이터 API 를
    실시간 호출하지 않는다 — 월 1회 배치가 만든 config/*.json 캐시만 읽는다.
    """
    from regional import coefficients as rc

    body = rc.table()
    if sido:
        body["selected"] = rc.breakdown(sido, gu)
    return body


def _build_profile(student_id: str):
    import db_supabase as db
    import engine

    student = db.get_student(student_id)
    if not student:
        return None
    scores = db.get_scores(student_id)
    prof = engine.profile(scores, student.get("enrollment"))
    return {"student": student, "scores": scores, **prof}


@app.get("/api/student/{student_id}")
def student_profile(student_id: str):
    try:
        prof = _build_profile(student_id)
        if not prof:
            return {"error": "not_found"}
        return prof
    except Exception as e:  # noqa: BLE001
        return {"error": str(e)}


@app.get("/api/student/{student_id}/scores")
def student_scores(student_id: str):
    import db_supabase as db
    import engine

    try:
        return {
            "scores": db.get_scores(student_id),
            "rounds": engine.ROUNDS,
            "judged_subjects": sorted(engine.subject_weights()),
            "subject_weights": {s: round(w, 4) for s, w in engine.subject_weights().items()},
            "scale": "percentile",   # 백분위 0~100, 높을수록 우수
        }
    except Exception as e:  # noqa: BLE001
        return {"scores": {}, "error": str(e)}


@app.get("/api/student/{student_id}/premium-breakdown")
def student_premium_breakdown(student_id: str):
    """월 보험료 상세 — 위험보험료·사업비·위험마진 3분해 (약관 별표4)."""
    import db_supabase as db
    import engine

    try:
        student = db.get_student(student_id)
        if not student:
            return {"error": "not_found"}
        pricing = engine.price(student.get("enrollment"))
        return {
            "tier": pricing["tier"],
            "monthly_premium": pricing["monthly_premium"],
            "gross_annual": pricing["gross_annual"],
            "remaining_months": pricing["remaining_months"],
            "late": pricing["late"], "theta": pricing["theta"],
            "coverage": {"mild": pricing["cover_mild"], "severe": pricing["cover_severe"]},
            **{k: v for k, v in pricing["breakdown"].items()
               if k not in ("tier", "monthly_premium", "gross_annual", "remaining_months")},
        }
    except Exception as e:  # noqa: BLE001
        return {"error": str(e)}


@app.get("/api/student/{student_id}/eligibility")
def student_eligibility(student_id: str, actual_percentile: float | None = None,
                        actual_grade: float | None = None):
    """보장 대상 판정 (약관 별표3).

    실제 수능 성적은 백분위로 받는다. 계리 판정(σ·임계값)은 등급 단위라
    engine 이 내부에서 환산한다.
    """
    import db_supabase as db
    import engine

    try:
        student = db.get_student(student_id)
        if not student:
            return {"error": "not_found"}
        scores = db.get_scores(student_id)
        return engine.eligibility(scores, student.get("enrollment"),
                                  actual_percentile=actual_percentile,
                                  actual_grade=actual_grade)
    except Exception as e:  # noqa: BLE001
        return {"error": str(e)}


@app.get("/api/student/{student_id}/renewals")
def student_renewals(student_id: str):
    """갱신 이력 + 캡 정보 (약관 별표1 · 제25조 · 제29조)."""
    import db_supabase as db
    import engine

    try:
        history = db.list_renewals(student_id)
    except Exception as e:  # noqa: BLE001
        history = []
        error = str(e)
    else:
        error = None
    return {
        "history": history,
        "steps": [{"step": s, "at": at, "rounds": rounds, "band": band}
                  for s, at, rounds, band in engine.RENEWAL_STEPS],
        "caps": {
            "increase_once": engine.CAP_INCREASE_ONCE,
            "decrease_once": engine.CAP_DECREASE_ONCE,
            "increase_cumulative": engine.CAP_INCREASE_CUMULATIVE,
        },
        "frozen_after": "고3 9월 모의평가 (이후 추가 갱신 없이 요율 동결)",
        **({"error": error} if error else {}),
    }


class DeclareSubjectsRequest(BaseModel):
    subjects: list[str]


@app.post("/api/student/{student_id}/declare-subjects")
def declare_subjects(student_id: str, req: DeclareSubjectsRequest):
    """수능 응시과목 선언 (약관 별표6).

    고3 9월 갱신 시점에 최소 2과목 이상 선언하며, 선언 이후에는 변경할 수 없다.
    급락 판정은 선언한 과목만으로 산출한다.
    """
    import db_supabase as db
    import engine

    allowed = set(engine.subject_weights())
    picked = [s for s in dict.fromkeys(req.subjects) if s in allowed]
    if len(picked) < 2:
        return {"ok": False, "error": "최소 2과목 이상 선언해야 합니다.",
                "allowed": sorted(allowed)}
    try:
        student = db.get_student(student_id)
        if not student:
            return {"ok": False, "error": "not_found"}
        enrollment = dict(student.get("enrollment") or {})
        if enrollment.get("declared_subjects") and len(enrollment["declared_subjects"]) >= 2:
            return {"ok": False, "error": "이미 선언되어 변경할 수 없습니다 (별표6).",
                    "declared_subjects": enrollment["declared_subjects"]}
        enrollment.pop("id", None)
        enrollment.pop("created_at", None)
        enrollment["student_id"] = student_id
        enrollment["declared_subjects"] = picked
        db.insert_enrollment(enrollment)
        return {
            "ok": True,
            "declared_subjects": picked,
            "subject_weights": {s: round(w, 4)
                                for s, w in engine.subject_weights(picked).items()},
        }
    except Exception as e:  # noqa: BLE001
        return {"ok": False, "error": str(e)}


@app.get("/api/surrender-value")
def surrender_value(paid_total: int = 0, stage: str | None = None):
    """해약환급금 (약관 별표5 표준형).

    시점이 늦을수록 환급률이 체감한다 — 수능 직전 선택적 해지를 억제하기 위함.
    """
    import engine

    table = [
        {"stage": s, "rate": r, "refund": round(paid_total * r)}
        for s, r in engine.SURRENDER_TABLE
    ]
    current = next((row for row in table if row["stage"] == stage), None)
    return {
        "paid_total": paid_total,
        "table": table,
        "current": current,
        "no_refund_discount": engine.SURRENDER_NO_REFUND_DISCOUNT,
        "note": "순수보장성 계약이라 저축 요소가 없고, 미경과보험료에서 해지공제를 뺀 금액입니다.",
    }


@app.post("/api/enroll")
def enroll(req: EnrollRequest):
    import re

    import db_supabase as db

    try:
        sid = "stu_" + re.sub(r"[^a-z0-9]", "", (req.name or "user").lower()) + "_" + str(abs(hash(req.name)) % 10000)
        survey = req.survey or {"source": req.source_site, "track": req.track, "target": req.target_univ}
        if req.gender:
            survey = {**survey, "성별": req.gender}
        import engine

        months = max(engine.MONTHS_DEADLINE,
                     min(int(req.enrolled_at_remaining_months), engine.MONTHS_FIRST))

        # 커넥션 하나로 묶는다. 예전엔 질의마다 새로 열어 서울 DB 까지 4번 왕복했고,
        # 제출 한 번에 7초가 걸려 함수 제한시간을 넘기면 브라우저가 'Load failed' 로 받았다.
        with db.connect() as conn:
            db.upsert_student({
                "student_id": sid, "name": req.name, "school": req.school, "grade_year": req.grade_year,
                "track": req.track, "target_univ": req.target_univ, "source_site": req.source_site,
            }, conn=conn)
            db.insert_enrollment({
                "student_id": sid, "tier": req.tier,
                "region": req.region,
                "academy_density_index": engine.density_index(req.region),
                "household_income_manwon": req.household_income_manwon,
                "monthly_edu_cost_manwon": req.monthly_edu_cost_manwon,
                "enrolled_at_remaining_months": months,
                "declared_subjects": req.declared_subjects or sorted(engine.subject_weights()),
                "surrender_type": req.surrender_type,
                "monthly_saving": req.monthly_saving, "retire_goal": req.retire_goal,
                "terms_agreed": req.terms_agreed,
                "survey": survey,
            }, conn=conn)
            # 신규 가입자는 성적 이력이 아직 없으므로, 데모용 기본 성적을 생성해 붙임.
            # 여기서 실패해도 청약 자체는 이미 저장됐으므로 가입은 성공으로 본다.
            try:
                if not db.get_scores(sid, conn=conn):
                    import random

                    import seed_supabase as seed

                    rng = random.Random(abs(hash(sid)) % 100000)
                    rows = seed.build_rows(seed.default_subject_profile(rng), rng)
                    db.insert_scores(sid, rows, conn=conn)
            except Exception:  # noqa: BLE001
                pass

        # 방금 저장한 청약 조건으로 산출한 보험료를 그대로 돌려준다 (가입완료 화면용)
        quote = None
        try:
            quote = engine.price({
                "tier": req.tier,
                "region": req.region,
                "household_income_manwon": req.household_income_manwon,
                "monthly_edu_cost_manwon": req.monthly_edu_cost_manwon,
                "enrolled_at_remaining_months": months,
            })
        except Exception:  # noqa: BLE001
            pass
        return {
            "ok": True, "student_id": sid,
            "monthly_premium": quote["monthly_premium"] if quote else None,
            "coverage": {"mild": quote["cover_mild"], "severe": quote["cover_severe"]} if quote else None,
            "remaining_months": months,
        }
    except Exception as e:  # noqa: BLE001
        return {"ok": False, "error": str(e)}


# ── RAG 챗봇 (개인화) ────────────────────────────────────────────────────────
# 고객에게 보여주는 것은 '보험료 구성 3분해'(약관 별표4)뿐이다.
#   위험보험료(보장 원가) + 사업비 + 위험마진(안전할증) = 월 보험료
# 요율 3지표(가구소득·학원밀집도·월교육비)는 SES 민감정보이므로 프롬프트에 싣지
# 않는다. 개인 재수확률(R)·급락확률·스코어카드 계수·수식·기호(σ, z)도 노출 금지.
def _breakdown_table(breakdown: dict) -> str:
    """구성 3분해를 프롬프트에 실을 표 데이터 줄로 만든다."""
    labels = [("risk_premium", "위험보험료 (보장 원가)"),
              ("expense", "사업비 (모집·심사·수금)"),
              ("risk_margin", "위험마진 (안전할증)")]
    monthly = breakdown["monthly_components"]
    ratios = breakdown["ratios"]
    ratio_keys = {"risk_premium": "loss_ratio", "expense": "expense_ratio",
                  "risk_margin": "risk_margin_ratio"}
    return "\n".join(
        f"    | {label} | {monthly[key]:,}원 | {ratios[ratio_keys[key]] * 100:.1f}% |"
        for key, label in labels
    )


def _student_context(student_id: str) -> str:
    try:
        prof = _build_profile(student_id)
        if not prof:
            return ""
        s = prof["student"]
        p = prof["pricing"]
        a = prof["analysis"]
        bd = p["breakdown"]
        weak_str = ", ".join(w["subject"] for w in a["weak_subjects"][:2])
        band = a["band"]
        mu = band["predicted_percentile"]
        late_note = (
            f"\n- 가입이 늦어(잔여 납입 {p['remaining_months']}개월) 늦은가입 할증이 붙었습니다: "
            f"연 {bd['late_surcharge']:,}원\n"
            if bd.get("late_surcharge") else ""
        )
        return (
            "\n[상담 대상 학생의 확정 산정값 — 우리 계리 엔진이 계산한 값이니 그대로 인용하세요. 새 숫자를 지어내지 마세요]\n"
            f"- 이름: {s['name']} ({s.get('school','')}, 목표 {s.get('target_univ','')})\n"
            f"- 가입 상품(티어): {p['tier']}  → 보장금 경증 {p['cover_mild']:,}원 / 중증 {p['cover_severe']:,}원\n"
            f"- 월 보험료: {p['monthly_premium']:,}원 (잔여 납입 {p['remaining_months']}개월)\n"
            + (f"- 예상 수능 백분위(본인 기준선): {mu}\n" if mu else "")
            + (f"- 보장 기준선: 경증 {band['mild_threshold_percentile']} 백분위 미만 / "
               f"중증 {band['severe_threshold_percentile']} 백분위 미만으로 떨어질 때\n"
               if band.get("mild_threshold_percentile") else "")
            + f"- 성적 기복이 큰 과목: {weak_str}\n"
            + f"- 급락 판정 대상 과목: {', '.join(a['judged_subjects'])}\n"
            + late_note
            + "\n[월 보험료 구성 — 아래 표를 '항목 | 월 금액 | 비중' 3열 그대로 옮기세요. 없는 항목·수치를 만들지 마세요]\n"
            "    | 항목 | 월 금액 | 비중 |\n"
            "    | --- | --- | --- |\n"
            f"{_breakdown_table(bd)}\n"
            f"  (합계 {p['monthly_premium']:,}원. 세 항목의 합이 곧 월 보험료입니다.)\n"
            "\n[설명 지침]\n"
            "- 금액을 물으면 월 보험료와 보장금액을 2열 표로 제시합니다.\n"
            "- '왜 이 금액인가'를 물으면 위 구성 표를 그대로 옮기고, 보장금이 큰 상품일수록\n"
            "  위험보험료가 커진다는 점을 설명합니다. 늦은가입 할증이 있으면 함께 안내합니다.\n"
            "- 개인 재수확률·급락확률 같은 확률 수치·명칭, 스코어카드 계수·공식·기호(σ, z),\n"
            "  가구소득·거주지·월교육비 같은 산정 지표는 어떤 형태로도 쓰지 마세요(컴플라이언스 규칙 5).\n"
            "- 이전 답변에서 안 보여준 항목을 새로 물으면, '오타/실수가 있었다'는 식으로 지어내\n"
            "  정정·사과하지 마세요. 앞서 안 보인 건 질문 범위가 좁았을 뿐입니다.\n"
            "- 낮추는 방법을 물으면 ① 위 '성적 기복이 큰 과목'이 안정되면 갱신 시 낮아질 수 있고\n"
            "  ② 일찍 가입할수록 늦은가입 할증이 없다는 두 가지를 안내합니다.\n"
        )
    except Exception:  # noqa: BLE001
        return ""


@app.get("/api/policy/sections")
def policy_sections(a: str = ""):
    """근거로 인용된 약관 조항의 전문 반환 (챗봇 근거 팝업용).

    a = 앵커 목록(쉼표 구분). 예: /api/policy/sections?a=제13조-...,별표4-...
    앵커를 비우면 목차를 돌려준다.
    """
    try:
        from rag_light import section_list, section_text

        anchors, seen = [], set()
        for x in a.split(","):
            x = x.strip()
            if x and x not in seen:
                seen.add(x)
                anchors.append(x)
        if not anchors:
            return {"sections": [], "toc": section_list()}
        return {"sections": [section_text(x) for x in anchors]}
    except Exception as e:  # noqa: BLE001
        return {"sections": [], "error": str(e)}


@app.get("/api/policy/pages", deprecated=True)
def policy_pages(p: str = ""):
    """[deprecated] 순번 기반 조항 조회. 신규 코드는 /api/policy/sections 를 쓸 것."""
    try:
        from rag_light import page_text

        nums, seen = [], set()
        for x in p.split(","):
            x = x.strip()
            if x.isdigit() and int(x) not in seen:
                seen.add(int(x))
                nums.append(int(x))
        return {"pages": [page_text(n) for n in nums]}
    except Exception as e:  # noqa: BLE001
        return {"pages": [], "error": str(e)}


@app.post("/api/chat", response_model=None)
def chat(req: ChatRequest):
    if not req.message.strip():
        return {"answer": "질문을 입력해 주세요.", "sources": [], "llm": False}
    try:
        from rag_light import answer_question

        ctx = _student_context(req.student_id) if req.student_id else ""
        out = answer_question(req.message, req.history or [], student_context=ctx)
        # provider/error 를 그대로 흘려보낸다 — 폴백이 일어났을 때 원인을 알 수 있어야 한다.
        return {
            "answer": out["answer"], "sources": out.get("sources", []), "llm": out.get("llm", False),
            "suggestions": out.get("suggestions", []),
            "provider": out.get("provider"), "error": out.get("error"),
        }
    except Exception as e:  # noqa: BLE001
        return {"answer": f"오류가 발생했습니다: {e}", "sources": [], "llm": False}


def main():
    import uvicorn

    uvicorn.run("main:app", host="0.0.0.0", port=8000, reload=True)


if __name__ == "__main__":
    main()
