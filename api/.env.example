# 이 파일을 .env 로 복사한 뒤 값을 채우세요:  cp .env.example .env
# .env 는 각자 로컬에만 두고, 절대 공유/커밋하지 마세요.

# ══════════════════════════════════════════════════════════════
# ★ 모델 테스트 시 아래 두 줄만 변경하세요 ★
# 회사: openai | anthropic | deepseek | grok | gemini
LLM_PROVIDER=anthropic
# 모델 예시:
# openai=gpt-4o | anthropic=claude-opus-4-8
# deepseek=deepseek-chat | grok=grok-3 | gemini=gemini-2.5-flash-lite
LLM_MODEL=claude-opus-4-8
# ══════════════════════════════════════════════════════════════

# ── 회사별 API 키 (사용할 회사의 키를 입력하세요) ──
OPENAI_API_KEY=

# Anthropic(Claude) 사용 시
# LLM_API_KEY=sk-ant-...

# DeepSeek 사용 시 (OpenAI 호환 API)
# DEEPSEEK_API_KEY=sk-...

# Grok / xAI 사용 시 (OpenAI 호환 API)
# GROK_API_KEY=xai-...

# Gemini 사용 시 (OpenAI 호환 엔드포인트, 무료 티어 있음)
# 키 발급: https://aistudio.google.com/apikey
# GEMINI_API_KEY=AIza...

# ── Supabase Postgres (개인화 대시보드용) ──
# 비워두면 챗봇은 동작하지만 학생 목록·성적·보험료 개인화는 꺼집니다.
# Supabase 대시보드 → Project Settings → Database → Connection pooling (포트 6543)
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=6543
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_NAME=postgres

# ── 학원비 카드 영수증 검증 ──
# Supabase가 설정되어 있으면 같은 PostgreSQL에 테이블을 생성합니다.
# 별도 DB URL을 지정하면 우선 사용합니다. 비워 두고 Supabase도 없으면 SQLite로 동작합니다.
RECEIPT_DATABASE_URL=
RECEIPT_SQLITE_PATH=.data/receipt_verification.db
RECEIPT_UPLOAD_DIR=uploads
OCR_PROVIDER=mock
OCR_CONFIDENCE_THRESHOLD=0.80
MAX_UPLOAD_SIZE_MB=10
MAX_PAYMENT_AGE_DAYS=365
APP_ENV=development
# production에서는 false로 설정하여 /mock-ocr 라우트를 등록하지 마세요.
ENABLE_MOCK_OCR_ENDPOINT=true

# ── 업로드 저장소 ──
# Vercel Functions 는 요청 간 디스크가 유지되지 않는다. 운영에서는 반드시
# local 이 아닌 원격 저장소를 지정해야 청구 플로우가 동작한다.
#   local | vercel-blob | supabase
RECEIPT_STORAGE=local
# vercel-blob 사용 시
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# RECEIPT_BLOB_PREFIX=receipts
# supabase 사용 시 (SUPABASE_URL 은 https://<project>.supabase.co)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# RECEIPT_BUCKET=receipts
