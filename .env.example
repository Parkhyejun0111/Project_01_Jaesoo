# 실제 값은 .env 에 넣는다 (.gitignore 처리됨). 이 파일은 키 목록만 알려준다.

# ── 지역계수 파이프라인 (api/regional) ──────────────────────────────────────
# 서울 열린데이터광장 인증키 — https://data.seoul.go.kr 회원가입 후 발급.
#   구보정계수(서울 각 구 학원 수강료) 수집에 쓴다.
SEOUL_API_KEY=

# KOSIS 국가통계포털 인증키 — https://kosis.kr/openapi 에서 발급.
#   시도계수(초중고 사교육비조사) 수집에 쓴다.
KOSIS_API_KEY=
# 기관코드 101 = 통계청.
KOSIS_ORG_ID=101
# DT_1PE105 = "학교급 및 시도별 학생 1인당 월평균 사교육비".
KOSIS_TBL_ID=DT_1PE105

# 항목코드. 비우면 T00(전체학생 평균)을 쓴다.
#   메타(getMeta&type=ITM)가 알려주는 값: T00 평균 / T01 초등학교 / T02 중학교
#                                        / T03 고등학교 / T04 일반고
# KOSIS_ITM_ID=T00

# 수집 대상 연도. 비우면 최신 확정연도를 메타(type=PRD)에서 읽어 쓴다.
# KOSIS_YEAR=2025

# 계수 JSON 을 읽고 쓸 디렉터리. 비우면 <repo>/config 와 api/config 를 쓴다.
# REGION_CONFIG_DIR=
