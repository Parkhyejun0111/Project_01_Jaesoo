# 이 파일을 .env 로 복사한 뒤 값을 채우세요:  cp .env.example .env
# .env 는 각자 로컬에만 두고, 절대 공유/커밋하지 마세요.

# ── AI 챗봇 LLM (둘 중 하나만 있어도 됨. 없으면 약관 발췌 폴백으로 동작) ──
# OpenAI 사용 시 (권장, 임시): 팀 대표에게 키를 받아 넣으세요
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic(Claude) 사용 시: OpenAI 키가 없을 때 대체로 사용됨
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-opus-4-8
